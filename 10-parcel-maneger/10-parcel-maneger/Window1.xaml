 <Window x:Class="_10_parcel_maneger.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_10_parcel_maneger"
        mc:Ignorable="d"
        Title="Surveyor Sync"
        Height="350"
        Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>


        <!-- TITLE -->
        <Label Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               FontSize="22"
               FontWeight="Bold"
               VerticalAlignment="Center">
            Parcel Manager
        </Label>


        <!-- ROOT FOLDER LABEL -->
        <Label Grid.Row="1"
               Grid.Column="0"
               Grid.ColumnSpan="2">
            Root Folder
        </Label>


        <!-- ROOT FOLDER PATH -->
        <TextBox x:Name="RootFolderTextBox"
                 Grid.Row="2"
                 Grid.Column="0"
                 Margin="0,0,10,0"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"/>

        <!-- BROWSE ROOT FOLDER -->
        <Button Grid.Row="2"
                Grid.Column="1"
                Content="Browse Folder"
                Click="BrowseRootFolder_Click"/>


        <!-- MASTER DWG LABEL -->
        <Label Grid.Row="3"
               Grid.Column="0"
               Grid.ColumnSpan="2">
            Master DWG
        </Label>


        <!-- MASTER DWG PATH -->
        <TextBox x:Name="MasterDwgTextBox"
                 Grid.Row="4"
                 Grid.Column="0"
                 Margin="0,0,10,0"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"/>

        <!-- BROWSE DWG -->
        <Button Grid.Row="4"
                Grid.Column="1"
                Content="Browse DWG"
                Click="BrowseMasterDwg_Click"/>


        <!-- OPEN MASTER DWG -->
        <Button Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="180"
                HorizontalAlignment="Center"
                Content="Open Master DWG"
                Click="OpenMasterDwg_Click"/>


        <!-- STATUS -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="6"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="0,15,0,0"
                   Text="Ready."
                   TextWrapping="Wrap"/>

    </Grid>

</Window>

