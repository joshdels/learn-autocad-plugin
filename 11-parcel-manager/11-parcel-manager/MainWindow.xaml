<Window x:Class="DwgManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Manager" Height="200" Width="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" 
                   Text="No folder selected." 
                   FontSize="13" Foreground="Gray"
                   Margin="0,0,0,16" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Browse Folder" Click="Browse_Click"
                    Width="140" Height="36" Margin="0,0,12,0" FontSize="13"/>
            <Button x:Name="OpenBtn" Content="Open TagumCity.dwg"
                    Width="160" Height="36" FontSize="13"
                    IsEnabled="False" Click="Open_Click"/>
        </StackPanel>
    </StackPanel>
</Window>